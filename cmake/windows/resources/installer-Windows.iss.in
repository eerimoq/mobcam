; Inno Setup script for the @PLUGIN_DISPLAY_NAME@ OBS plugin.
;
; CMake configures this into the build directory as
; installer-Windows.generated.iss. Package-Windows.ps1 compiles it with ISCC,
; passing the staged install tree as /DReleaseDir=<path> and the output name as
; /F, so the same script builds the installer for any configuration.

#define MyAppName "@PLUGIN_DISPLAY_NAME@"
#define MyPluginName "@CMAKE_PROJECT_NAME@"
#define MyAppVersion "@CMAKE_PROJECT_VERSION@"
#define MyAppPublisher "@PLUGIN_AUTHOR@"
#define MyAppURL "@PLUGIN_WEBSITE@"

#ifndef ReleaseDir
  #define ReleaseDir "@INSTALLER_SOURCE_DIR@\release\RelWithDebInfo"
#endif

[Setup]
; Keep this AppId stable forever: it is what lets a new installer replace an
; older installation instead of adding a second entry.
AppId={{96090BDC-36BD-4DAD-8DA7-D0C3B8F7A88C}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
VersionInfoVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
LicenseFile=@INSTALLER_SOURCE_DIR@\LICENSE

; OBS loads plugins from %ProgramData%\obs-studio\plugins, which is where the
; zip archive is meant to be unpacked too. Installing there needs no knowledge
; of where OBS itself was installed.
DefaultDirName={commonappdata}\obs-studio\plugins\{#MyPluginName}
DisableDirPage=yes
DisableProgramGroupPage=yes
Uninstallable=yes
UninstallDisplayName={#MyAppName} {#MyAppVersion}

; Writing under %ProgramData% and registering an uninstall entry both need
; elevation. No architecture directives: the plugin goes to an architecture
; independent directory, and x64 OBS runs on ARM64 Windows too.
PrivilegesRequired=admin
MinVersion=10.0

OutputDir=@INSTALLER_SOURCE_DIR@\release
OutputBaseFilename={#MyPluginName}-{#MyAppVersion}-windows-x64-Installer
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "{#ReleaseDir}\{#MyPluginName}\bin\64bit\*"; DestDir: "{app}\bin\64bit"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#ReleaseDir}\{#MyPluginName}\data\*"; DestDir: "{app}\data"; Flags: ignoreversion recursesubdirs createallsubdirs

[UninstallDelete]
Type: dirifempty; Name: "{app}\bin\64bit"
Type: dirifempty; Name: "{app}\bin"
Type: dirifempty; Name: "{app}\data"
Type: dirifempty; Name: "{app}"
